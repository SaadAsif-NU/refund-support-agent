# ─────────────────────────────────────────────────────────────
#  NimbusMart AI Refund Agent - configuration
# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and paste in any keys you have.
#  The app runs with NO keys in offline "mock" mode. Each provider
#  below becomes selectable in the UI as soon as its key is present.
#  Keys stay on the server and are never sent to the browser.

# Which provider is selected by default (mock | groq | gemini | openai | anthropic).
DEFAULT_PROVIDER=mock

# ── Groq - free tier, fast tool-calling (recommended) ──
#   Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini - free tier ──
#   Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (GPT) - paid ──
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5          # or gpt-4o-mini for a cheaper option

# ── Anthropic (Claude) - paid ──
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # or claude-haiku-4-5 for a cheaper option

# ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
